#API
PORT=3001
NODE_ENV=development
SERVICE_NAME=ApiTSExpress
API_VERSION=1.0.0
# Auth
JWT_SECRET=change_me_super_secret
#DataSource: "dummy" (in-memory, default) | "sqlserver" | "oracle"
DATA_SOURCE=dummy
#DB (SQL Server)
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1434
DB_USER=sa
# Required only when DATA_SOURCE=sqlserver. The app fails to start if missing.
DB_PASSWORD=change_me
DB_NAME=testdb
#Oracle. Required only when DATA_SOURCE=oracle. The app fails to start if missing.
ORACLE_USER=appuser
ORACLE_PASSWORD=change_me
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
#SYS password, only used by docker-compose to bootstrap the container.
ORACLE_SYS_PASSWORD=change_me
ORACLE_PORT=1521
#LOG
#Logger implementation: "pino" (default) | "winston"
LOG_DRIVER=pino
LOG_LEVEL=trace
