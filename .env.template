#API
PORT=3001
NODE_ENV=development
SERVICE_NAME=ApiTSExpress
API_VERSION=1.0.0
# Auth
JWT_SECRET=change_me_super_secret
#HTTP hardening
#Allowed CORS origins, comma separated. Add as many as you need: the deployed
#front and the localhost you debug it from. Empty = same origin only.
#"*" is an explicit wildcard for development.
CORS_ORIGINS=http://localhost:3001
#Max JSON / urlencoded body size. 1mb is plenty: uploads stream through busboy
#and never reach these parsers.
BODY_LIMIT=1mb
#Trusted proxy hops in front of the app (0 = none, 1 = one nginx / load balancer).
#Never "true": the rate limiter would count a client-supplied IP.
TRUST_PROXY_HOPS=0
#Global rate limit, per IP. RATE_LIMIT_MAX=0 disables it.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
#Rate limit for the routes that hand out credentials (/api/generate-token).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
#Content-Security-Policy. Off by default: helmet's default policy breaks the
#demo UI (Tailwind CDN), Swagger UI and Scalar. Turn it on once you serve your
#own front, and tune DEMO_UI_CSP in src/core/config/security.config.ts.
CSP_ENABLED=false
#Swagger / Scalar / openapi.json. Empty = enabled everywhere except production.
DOCS_ENABLED=
#Graceful shutdown
#Gap between reporting "not ready" and closing the socket, so the load balancer
#stops routing here before the port goes away. This is what removes the 502s on
#a rolling deploy; behind Kubernetes, 5000 is a good starting point.
SHUTDOWN_DELAY_MS=0
#Whole-shutdown budget. Keep it below the orchestrator's grace period.
SHUTDOWN_TIMEOUT_MS=10000
#DataSource: "dummy" | "oracle" | "sqlserver" | "postgres" | "mysql" | "mongodb"
DATA_SOURCE=dummy
#DB (SQL Server)
DB_HOST=localhost
DB_PORT=1434
DB_USER=sa
# Required only when DATA_SOURCE=sqlserver. The app fails to start if missing.
DB_PASSWORD=change_me
DB_NAME=testdb
#Oracle. Required only when DATA_SOURCE=oracle. The app fails to start if missing.
ORACLE_USER=appuser
ORACLE_PASSWORD=change_me
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
#SYS password, only used by docker-compose to bootstrap the container.
ORACLE_SYS_PASSWORD=change_me
ORACLE_PORT=1521
#PostgreSQL (docker compose up postgres). Required only when DATA_SOURCE=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=testdb
#MySQL / MariaDB (docker compose up mysql). Required only when DATA_SOURCE=mysql.
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me
MYSQL_DB=testdb
#MongoDB (docker compose up mongo). Required only when DATA_SOURCE=mongodb.
#El contenedor de desarrollo corre sin autenticacion: si se dejan vacios,
#el conector se conecta sin credenciales y la app arranca igual.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=testdb
MONGO_USER=
MONGO_PASSWORD=
#LOG
#Logger implementation: "pino" (default) | "winston"
LOG_DRIVER=pino
LOG_LEVEL=trace
