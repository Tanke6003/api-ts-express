{
  "name": "api-ts-express",
  "version": "1.2.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/main.ts",
    "dev:win": "set NODE_ENV=development&& tsx watch src/main.ts",
    "dev:win:pretty": "set NODE_ENV=development&& tsx watch src/main.ts | npx pino-pretty --singleLine --colorize --translateTime \"SYS:isoTime\" --ignore pid,hostname,service,env,version",
    "build": "tsc -p tsconfig.json",
    "build:stg": "NODE_ENV=staging tsc -p tsconfig.json",
    "build:prd": "NODE_ENV=production tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/main.js",
    "start:win": "set NODE_ENV=production&& node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch --verbose",
    "test:local": "jest --coverage --verbose --detectOpenHandles --runInBand --coverageReporters=text --coverageReporters=text-summary --coverageReporters=lcov --coverageReporters=html --coverageReporters=json-summary",
    "test:repo": "jest --coverage --coverageReporters=text-summary",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"public/**/*.js\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:repo"
  },
  "keywords": [
    "typescript",
    "express",
    "clean-architecture",
    "generic-repository",
    "unit-of-work",
    "tsyringe",
    "oracle",
    "sqlserver",
    "postgres",
    "mysql",
    "mongodb"
  ],
  "author": "tanke6003",
  "license": "ISC",
  "description": "REST API template on Node.js, Express 5 and TypeScript, following Clean Architecture: one generic repository over Oracle, SQL Server, PostgreSQL, MySQL/MariaDB, MongoDB or memory.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@scalar/express-api-reference": "^0.8.18",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.3",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0",
    "pino": "^9.11.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.29.0",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^18.6.1",
    "tsyringe": "^4.10.0",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.0",
    "@types/oracledb": "^7.0.2",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "jest-html-reporter": "^4.3.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
