#API
PORT=3001
NODE_ENV=development
SERVICE_NAME=ApiTSExpress
API_VERSION=1.2.0
# Auth
JWT_SECRET=change_me_super_secret
#DataSource: "dummy" | "oracle" | "sqlserver" | "postgres" | "mysql" | "mongodb"
#Data source to use for the application. The default is "dummy", which uses an in-memory data source.
#Is the  origin of the data source. The application can be configured to use different data sources for different environments.
DATA_SOURCE=oracle
#DB (SQL Server)
DB_HOST=localhost
# 1434 lo ocupa el SQL Server instalado en esta maquina (127.0.0.1:1434),
# asi que el contenedor se publica en 1435. Compose lee la misma variable.
DB_PORT=1435
DB_USER=sa
DB_PASSWORD=StrongPassword123!
DB_NAME=testdb
#Oracle (docker compose up oracle). Required only when DATA_SOURCE=oracle.
ORACLE_USER=appuser
ORACLE_PASSWORD=AppPassword1
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
#SYS password, only used by docker-compose to bootstrap the container.
ORACLE_SYS_PASSWORD=OraclePassword1
ORACLE_PORT=1521
#PostgreSQL (docker compose up postgres). Required only when DATA_SOURCE=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=appuser
POSTGRES_PASSWORD=AppPassword1
POSTGRES_DB=testdb
#MySQL / MariaDB (docker compose up mysql). Required only when DATA_SOURCE=mysql.
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=appuser
MYSQL_PASSWORD=AppPassword1
MYSQL_DB=testdb
#MongoDB (docker compose up mongo). Required only when DATA_SOURCE=mongodb.
#El contenedor de desarrollo corre sin autenticacion: MONGO_USER y MONGO_PASSWORD
#se dejan vacios y el conector no envia credenciales.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=testdb
MONGO_USER=
MONGO_PASSWORD=
#LOG
#Logger implementation: "pino" (default) | "winston"
## Pino is a very fast logger, but it is not compatible with the default Node.js console.log.
## Winston is slower, but it is compatible with console.log and has more features.
LOG_DRIVER=pino
# Log level: trace | debug | info | warn | error | fatal
# Ordenados de más a menos verboso. El nivel elegido registra ese nivel
# y todos los superiores (ej. "warn" incluye también error y fatal).
#
# trace -> detalle exhaustivo: entradas/salidas de función, payloads completos.
#          Se activa unos minutos para cazar un bug y se apaga. Nunca fijo en prod.
# debug -> puntos clave del flujo, para entender qué hizo el programa. Desarrollo.
# info  -> eventos normales de operación (arranque, peticiones servidas).
#          Valor por defecto y recomendado en producción.
# warn  -> algo raro, pero la app siguió funcionando (reintento, fallback, config obsoleta).
# error -> una operación falló y alguien se vio afectado. Requiere investigación.
# fatal -> el proceso no puede continuar y va a terminar.
LOG_LEVEL=trace
