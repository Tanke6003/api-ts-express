# https://editorconfig.org
#
# Lo que el editor tiene que respetar antes de que el linter opine. ESLint puede
# arreglar comillas y punto y coma, pero no recupera un fichero guardado en
# CRLF o sin salto final: eso se decide al escribir, y por eso vive aquí.
root = true

# end_of_line = lf no es preferencia: los .sh y .sql se ejecutan dentro de los
# contenedores y con CRLF bash falla con "bad interpreter: ...^M".
# El .gitattributes lo fuerza también en el checkout.
#
# max_line_length lo lee Prettier como printWidth, así que este es el único
# sitio donde se declara el ancho.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# En Markdown dos espacios al final son un salto de línea, así que recortarlos
# cambiaría el texto renderizado.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

# Generado por Vitest/Jest: que el editor no lo reformatee al abrirlo.
[*.snap]
trim_trailing_whitespace = false